# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eflora_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/*
ALLOWED_DOC_TYPES=application/pdf,image/jpeg,image/png

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Cloudinary (recommended for product images)
CLOUDINARY_CLOUD_NAME=dt41kulx6
CLOUDINARY_API_KEY=846138634482439
CLOUDINARY_API_SECRET=Aa8a5Xbiw6LElp5KFNPuZznE9T0

# Email Configuration (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@eflora.com
FROM_NAME=eFlora Marketplace

# Payment Gateway (Razorpay)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Company Details (for invoices)
COMPANY_NAME=eFlora Marketplace
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_PINCODE=
COMPANY_PHONE=
COMPANY_EMAIL=support@eflora.com
